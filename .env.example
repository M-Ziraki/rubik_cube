# Cube Atlas runs completely without any of this. Everything below is optional.
#
# A key here is read by the Node server only (`npm run serve`, or the dev
# server). It is never bundled into the browser build and never sent to the
# browser. Learners can also bring their own key from the Settings page
# instead, in which case this file is not needed at all.

# Your TypeSafe API key. Get one at https://typesafe.ai
TYPESAFE_API_KEY=

# Optional. Defaults to jev-latest.
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional. Defaults to https://api.typesafe.ai
# TYPESAFE_BASE_URL=

# Set to 1 only when the server sits behind a reverse proxy you control, so
# that x-forwarded-for can be trusted for rate limiting.
# TRUST_PROXY=0
