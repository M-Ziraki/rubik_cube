{
  "name": "cube-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive laboratory for the Rubik's Cube as a graph-theory problem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/M-Ziraki/rubik_cube.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-filenames.mjs && node scripts/i18n-report.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vite-node bench/solve.ts",
    "bench:hard": "vite-node bench/superflip.ts",
    "smoke": "node scripts/smoke.mjs",
    "bench:20": "vite-node bench/target20.ts",
    "acceptance": "node scripts/acceptance.mjs",
    "check:names": "node scripts/check-filenames.mjs",
    "i18n:report": "node scripts/i18n-report.mjs",
    "verify": "node scripts/verify.mjs",
    "serve": "vite-node server/index.ts",
    "jev:eval": "vite-node evals/run.ts --",
    "verify:jev": "node scripts/verify-jev.mjs",
    "verify:ux": "node scripts/verify-ux.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vite-node": "^2.1.8"
  }
}
