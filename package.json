{
  "name": "cube-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive laboratory for the Rubik's Cube as a graph-theory problem.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vite-node bench/solve.ts",
    "bench:hard": "vite-node bench/superflip.ts",
    "smoke": "node scripts/smoke.mjs",
    "bench:20": "vite-node bench/target20.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
